    "@unocss/nuxt": "^66.6.8",
    "@vue-flow/core": "1.48.2",
    "@vue/compiler-dom": "^3.5.34",
    "devframe": "1.2.3",
    "elkjs": "0.11.0",
    "magic-string": "^0.30.21",
    "nitropack": "2.13.4",
    "prettier": "^3.9.9",
    "shiki": "^4.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "unocss": "^66.6.8",
    "valibot": "^1.5.0",
    "vue-tsc": "^3.1.0"
